{
  "name": "@logixsoft/mail",
  "version": "1.0.0",
  "description": "Client SDK and direct helper functions for Logixsoft Mail Worker",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "email",
    "mail",
    "client",
    "sdk",
    "cloudflare-workers"
  ],
  "license": "MIT"
}
