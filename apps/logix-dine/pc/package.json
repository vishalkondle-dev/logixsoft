{
  "name": "logix-dine-pc",
  "version": "0.1.0",
  "description": "Logix Dine Desktop POS & Management for Windows, macOS, and Linux",
  "homepage": "https://dine.logixsoft.in",
  "main": "dist/main/index.cjs",
  "author": "Logix Soft <support@logixsoft.in>",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "pnpm build && electron .",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/main/index.cjs --external:electron",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/preload/index.cjs --external:electron",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "start": "electron .",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:linux": "pnpm build && electron-builder --linux",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node tests/e2e.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "playwright": "^1.49.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
