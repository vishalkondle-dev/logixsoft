{
  "name": "@logixsoft/mail-worker",
  "version": "1.0.0",
  "description": "Email sender via SMTP for Cloudflare Workers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external cloudflare:sockets",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.5",
    "wrangler": "^4.122.0"
  },
  "keywords": [
    "email",
    "smtp",
    "cloudflare-workers",
    "mailer"
  ],
  "license": "MIT",
  "dependencies": {
    "@mantine/core": "^9.7.3",
    "@mantine/dates": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@mantine/notifications": "^9.7.3",
    "@mantine/tiptap": "^9.7.3",
    "@tabler/icons-react": "^3.49.0",
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "hono": "^4.13.13",
    "jsonwebtoken": "^9.0.3",
    "postal-mime": "^4.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
