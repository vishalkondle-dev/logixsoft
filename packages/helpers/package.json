{
  "name": "@logixsoft/helpers",
  "version": "1.0.0",
  "description": "Shared helpers, database connection lifecycle, cryptography, HTTP envelopes, string utilities, validators, currency, date, and primitives for Logixsoft applications",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js",
      "require": "./dist/db.cjs"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js",
      "require": "./dist/crypto.cjs"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js",
      "require": "./dist/http.cjs"
    },
    "./string": {
      "types": "./dist/string.d.ts",
      "import": "./dist/string.js",
      "require": "./dist/string.cjs"
    },
    "./date": {
      "types": "./dist/date.d.ts",
      "import": "./dist/date.js",
      "require": "./dist/date.cjs"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js",
      "require": "./dist/data.cjs"
    },
    "./validators": {
      "types": "./dist/validators.d.ts",
      "import": "./dist/validators.js",
      "require": "./dist/validators.cjs"
    },
    "./currency": {
      "types": "./dist/currency.d.ts",
      "import": "./dist/currency.js",
      "require": "./dist/currency.cjs"
    },
    "./do": {
      "types": "./dist/do.d.ts",
      "import": "./dist/do.js",
      "require": "./dist/do.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/db.ts src/crypto.ts src/http.ts src/string.ts src/date.ts src/data.ts src/validators.ts src/currency.ts src/do.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts src/db.ts src/crypto.ts src/http.ts src/string.ts src/date.ts src/data.ts src/validators.ts src/currency.ts src/do.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "license": "MIT"
}
